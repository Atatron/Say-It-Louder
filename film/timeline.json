 "subs": [
  {
   "start": 9.059,
   "end": 10.148,
   "text": "Ini Senja."
  },
  {
   "start": 10.178,
   "end": 11.438,
   "text": "Usianya dua puluh empat tahun."
  },
  {
   "start": 11.468,
   "end": 15.112,
   "text": "Guru honorer di sebuah SMP di Jawa Barat."
  },
  {
   "start": 15.512,
   "end": 16.783,
   "text": "Anak sulung."
  },
  {
   "start": 16.813,
   "end": 18.325,
   "text": "Orang tuanya bercerai."
  },
  {
   "start": 18.355,
   "end": 20.713,
   "text": "Enam bulan lalu, ayahnya meninggal."
  },
  {
   "start": 21.013,
   "end": 25.731,
   "text": "Kini ia memikul ibunya, dua adiknya, dan sekolahnya, di pundaknya."
  },
  {
   "start": 25.881,
   "end": 27.674,
   "text": "Dan ia tak punya siapa pun untuk bercerita."
  },
  {
   "start": 28.874,
   "end": 30.6,
   "text": "Lalu bisikan itu mulai datang."
  },
  {
   "start": 31.974,
   "end": 32.91,
   "text": "“Ayo pulang.”"
  },
  {
   "start": 32.94,
   "end": 34.706,
   "text": "Empat, lima kali sehari."
  },
  {
   "start": 34.756,
   "end": 36.732,
   "text": "Bayangan hitam berjalan mendekatinya."
  },
  {
   "start": 36.932,
   "end": 38.549,
   "text": "Ia menutup telinganya."
  },
  {
   "start": 38.649,
   "end": 42.272,
   "text": "Bulan Mei, keluarganya membawanya ke rumah sakit jiwa."
  },
  {
   "start": 42.972,
   "end": 44.297,
   "text": "Ia tidak sendirian."
  },
  {
   "start": 44.327,
   "end": 47.27,
   "text": "24 juta orang di dunia hidup dengan skizofrenia."
  },
  {
   "start": 47.3,
   "end": 49.125,
   "text": "Tujuh dari sepuluh mendengar suara-suara."
  },
  {
   "start": 49.155,
   "end": 52.183,
   "text": "Bagi hingga tiga dari sepuluh, obat saja tidak cukup."
  },
  {
   "start": 52.983,
   "end": 54.878,
   "text": "Perawatnya mencoba sesuatu yang sederhana."
  },
  {
   "start": 54.908,
   "end": 57.173,
   "text": "Kertas. Dan sekotak krayon."
  },
  {
   "start": 57.473,
   "end": 59.896,
   "text": "Hari pertama: gumpalan benang hitam yang kusut."
  },
  {
   "start": 61.196,
   "end": 64.153,
   "text": "Hari kedua: ruangan di sekitarnya, digambar dengan teliti."
  },
  {
   "start": 65.253,
   "end": 70.103,
   "text": "Hari ketiga: pegunungan yang dulu sering ia gambar bersama ayah dan ibunya."
  },
  {
   "start": 71.003,
   "end": 73.558,
   "text": "Sembilan tanda halusinasi, tinggal satu."
  },
  {
   "start": 73.658,
   "end": 76.113,
   "text": "Menggambar memindahkan yang ada di dalam, ke luar."
  },
  {
   "start": 76.913,
   "end": 80.117,
   "text": "Maka kami bertanya: bisakah suara itu sendiri dibawa ke luar?"
  },
  {
   "start": 80.267,
   "end": 85.102,
   "text": "Saat kita bicara, bahkan dalam hati, otak mengirim salinan yang berkata: ini aku."
  },
  {
   "start": 85.202,
   "end": 88.209,
   "text": "Pada banyak orang yang mendengar suara, salinan itu lemah."
  },
  {
   "start": 88.239,
   "end": 91.047,
   "text": "Suara batin mereka sendiri bisa terdengar seperti orang lain."
  },
  {
   "start": 91.077,
   "end": 93.273,
   "text": "Dan bibir mereka bisa bergerak saat mendengarnya."
  },
  {
   "start": 94.273,
   "end": 95.651,
   "text": "Inilah You, Yourself."
  },
  {
   "start": 95.681,
   "end": 97.434,
   "text": "Ini Aku."
  },
  {
   "start": 97.834,
   "end": 100.505,
   "text": "Kanal dalam: dua elektroda di bawah bibir bawah."
  },
  {
   "start": 100.535,
   "end": 104.02,
   "text": "Sensor MyoWare mengubah aktivitas otot menjadi sinyal."
  },
  {
   "start": 104.05,
   "end": 109.634,
   "text": "ESP32 membacanya seribu kali per detik, lalu mengirimkannya ke ponselnya."
  },
  {
   "start": 109.734,
   "end": 112.725,
   "text": "Tiga detik istirahat menentukan ambang pribadinya."
  },
  {
   "start": 112.775,
   "end": 116.308,
   "text": "Di atas garis selama tiga ratus milidetik: otot bicara."
  },
  {
   "start": 116.338,
   "end": 117.264,
   "text": "Bukan menelan."
  },
  {
   "start": 117.294,
   "end": 118.641,
   "text": "Bukan mengunyah."
  },
  {
   "start": 118.671,
   "end": 122.17,
   "text": "Kanal luar: mikrofon memeriksa apakah ada orang yang benar-benar berbicara."
  },
  {
   "start": 122.2,
   "end": 123.821,
   "text": "Tidak ada yang direkam."
  },
  {
   "start": 123.871,
   "end": 126.348,
   "text": "Dua kanal. Satu jawaban yang lembut."
  },
  {
   "start": 126.948,
   "end": 129.013,
   "text": "Sekarang bayangkan Senja, memakainya."
  },
  {
   "start": 130.537,
   "end": 131.969,
   "text": "Bibirnya bergerak, nyaris tak terlihat."
  },
  {
   "start": 131.999,
   "end": 133.662,
   "text": "Tak ada orang lain yang berbicara."
  },
  {
   "start": 135.762,
   "end": 137.969,
   "text": "Dua ketukan lembut. Ini kamu."
  },
  {
   "start": 138.069,
   "end": 139.887,
   "text": "Ia bersenandung satu nada lembut,"
  },
  {
   "start": 141.887,
   "end": 143.687,
   "text": "dan suara itu mereda."
  },
  {
   "start": 143.887,
   "end": 147.835,
   "text": "Setiap momen tercatat di buku harian, untuk dokter dan perawatnya."
  },
  {
   "start": 148.435,
   "end": 149.575,
   "text": "Ini bukan obat."
  },
  {
   "start": 149.605,
   "end": 151.612,
   "text": "Ia membaca otot, bukan pikiran."
  },
  {
   "start": 151.642,
   "end": 153.325,
   "text": "Semua data tetap di ponselnya."
  },
  {
   "start": 153.355,
   "end": 155.99,
   "text": "Komponennya sekitar satu juta rupiah."
  },
  {
   "start": 156.69,
   "end": 159.245,
   "text": "Senja menemukan jalan pulang lewat krayon."
  },
  {
   "start": 161.011,
   "end": 162.708,
   "text": "Pulanglah, kepada dirimu sendiri."
  }
 ]
}